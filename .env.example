# Server
PORT=4000
LOG_LEVEL=info

# Set to "true" to test without real API calls (POC mode)
DRY_RUN=true

# Reddit API Credentials (free — register at reddit.com/prefs/apps after API approval)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# TikTok Content Posting API (free — apply at developers.tiktok.com)
TIKTOK_ACCESS_TOKEN=
